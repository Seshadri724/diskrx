{
  "name": "myapp-dev",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  "postCreateCommand": "pip install dxcli",

  "postStartCommand": "dxcli diagnose ~ --classify || true",

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.env.linux": {
          "DXCLI_ALERT_THRESHOLD": "80"
        }
      }
    }
  }
}
