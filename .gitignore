# pyenv
#   For a library or binary, you wish to ignore any local version file.
#   For an application, you wish to keep it.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or even
#   fail to install them on other platforms.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in version control.
#   https://python-poetry.org/docs/basic-usage/#commit-your-poetrylock-file-to-version-control
# poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in version control.
# pdm.lock
#   pdm also generates a .pdm-python file to store the path of the current Python interpreter.
.pdm-python
#   pdm stores project-wide configurations in .pdm-project/
.pdm-project/

# PEP 582; used by e.g. github.com/pdm-project/pdm
